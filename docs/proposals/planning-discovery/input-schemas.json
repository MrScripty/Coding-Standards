        },
        "source_policy": {
          "$ref": "#/$defs/CanonicalId"
        },
        "source_scope": {
          "oneOf": [
            {
              "$ref": "#/$defs/ReviewScope"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source_policy",
        "consumer",
        "relation",
        "applicability",
        "source_scope",
        "consumer_scope",
        "evidence_owner",
        "rationale"
      ],
      "type": "object"
    },
    "RelationshipConsumer": {
      "oneOf": [
        {
          "$ref": "#/$defs/CanonicalId"
        },
        {
          "$ref": "#/$defs/AuthoringTargetHandle"
        }
      ]
    },
    "ReviewScope": {
      "oneOf": [
        {
          "$ref": "#/$defs/StructuredScope"
        },
        {
          "$ref": "#/$defs/WholeArtifactScope"
        }
      ]
    },
    "AuthoringTargetHandle": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/ChildId"
        },
        "kind": {
          "const": "authoring-target-handle"
        },
        "schema_version": {
          "const": 5
        },
        "snapshot": {
          "$ref": "#/$defs/SnapshotHandle"
        }
      },
      "required": [
        "kind",
        "snapshot",
        "id",
        "schema_version"
      ],
      "type": "object"
    },
    "StructuredScope": {
      "additionalProperties": false,
      "properties": {
        "heading_path": {
          "items": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "minItems": 1,
          "type": "array"
        },
        "kind": {
          "const": "structured"
        }
      },
      "required": [
        "kind",
        "heading_path"
      ],
      "type": "object"
    },
    "AgentAuthoredDecisionProvenance": {
      "additionalProperties": false,
      "properties": {
        "alternatives": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/AgentEvidenceReference"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/CanonicalId"
        },
        "limits": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "origin": {
          "enum": [
            "documented-original",
            "reconstructed-history",
            "current-justification",
            "unrecorded"
          ]
        },
        "rationale": {
          "type": "string"
        },
        "reconsideration": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "subject": {
          "$ref": "#/$defs/CanonicalId"
        },
        "supersedes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "subject",
        "origin",
        "rationale",
        "evidence"
      ],
      "type": "object"
    },
    "AgentEvidenceReference": {
      "oneOf": [
        {
          "$ref": "#/$defs/EvidenceReference"
        },
        {
          "$ref": "#/$defs/EvidenceUse"
        }
      ]
    },
    "EvidenceUse": {
      "additionalProperties": false,
      "description": "Select one exact reference from the evidence table of this request only. This is not an authorization or an attestation.",
      "properties": {
        "evidence_ref": {
          "$ref": "#/$defs/CanonicalId"
        }
      },
      "required": [
        "evidence_ref"
      ],
      "type": "object"
    },
    "Digest": {
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "ReviseOperationalArtifactEdit": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "type": "string"
        },
        "kind": {
          "const": "revise-operational-artifact"
        },
        "target": {
          "oneOf": [
            {
              "$ref": "#/$defs/CanonicalId"
            },
            {
              "$ref": "#/$defs/AuthoringTargetHandle"
            }
          ]
        },
        "title": {
          "$ref": "#/$defs/NonEmptyString"
        }
      },
      "required": [
        "kind",
        "target",
        "title",
        "body"
      ],
      "type": "object"
    },
    "ChildId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "WholeArtifactScope": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "whole-artifact"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    }
  },
  "edit_schemas": {
    "create-standard": "CreateStandardEdit",
    "revise-standard": "ReviseStandardEdit",
    "register-policy-unit": "RegisterPolicyUnitEdit",
    "revise-policy-unit": "RevisePolicyUnitEdit",
    "put-routing-fact": "PutRoutingFactEdit",
    "put-routing-rule": "PutRoutingRuleEdit",
    "revise-operational-artifact": "ReviseOperationalArtifactEdit",
    "put-policy-relationship": "PutPolicyRelationshipEdit",
    "put-provenance": "AgentPutDecisionProvenanceEdit",
    "approve-application-content": "ApproveApplicationContentEdit"
  }
}
