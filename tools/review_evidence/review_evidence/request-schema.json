{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": 1
    },
    "repository_label": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "review_question": {
      "type": "string",
      "minLength": 1
    },
    "revisions": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 32,
      "required": [
        "baseline",
        "candidate"
      ],
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "revision",
        "path"
      ]
    },
    "context": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 4096,
      "uniqueItems": true
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "revision": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 4096,
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "revision",
          "scopes"
        ]
      },
      "maxItems": 4096
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "origin": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "git-file"
                  },
                  "revision": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-z][a-z0-9-]*$"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "revision",
                  "path"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "local-file"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "expected_sha256": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "kind",
                  "path"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "reference"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "label"
                ]
              }
            ]
          },
          "reported_repository": {
            "type": "string",
            "minLength": 1
          },
          "reported_subject_revision": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          }
        },
        "required": [
          "id",
          "role",
          "origin"
        ]
      },
      "maxItems": 4096
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "maxItems": 4096,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "artifacts"
        ]
      },
      "maxItems": 4096
    }
  },
  "required": [
    "format_version",
    "repository_label",
    "label",
    "review_question",
    "revisions",
    "plan",
    "context",
    "comparisons",
    "artifacts",
    "claims"
  ]
}
