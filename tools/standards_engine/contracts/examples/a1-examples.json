    {
      "name": "create-proposal",
      "definition": "CreateProposalCall",
      "value": {
        "kind": "create-proposal",
        "base_snapshot": {
          "kind": "snapshot-handle",
          "id": "snapshot:v1:00000000-0000-4000-8000-000000000001",
          "schema_version": 5
        },
        "change_set": {
          "purpose": {
            "summary": "Clarify when written plans are required",
            "rationale": "The policy should distinguish coordination risk from file-category triggers.",
            "evidence": [
              {
                "id": "evidence.planning-review",
                "digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                "provider_contract": "review-evidence",
                "provider_contract_version": "1"
              }
            ]
          },
          "edits": [
            {
              "kind": "revise-policy-unit",
              "policy": "workflow.planning.written-plan-applicability",
              "title": "When A Written Plan Is Required",
              "body": "Create a written plan when material sequencing, coordination, rollout, risk, or acceptance complexity must remain stable during implementation.",
              "semantics": {
                "kind": "change",
                "accepted_semantic_revision": 1,
                "proposed_semantic_revision": 2,
                "intent": "Make coordination complexity, rather than file category, the deciding planning trigger."
              }
            }
          ]
        }
      }
    },
    {
      "name": "find-proposals",
      "definition": "FindProposalsCall",
      "value": {
        "kind": "find-proposals",
        "limit": 25
      }
    },
    {
      "name": "revise-proposal",
      "definition": "ReviseProposalCall",
      "value": {
        "kind": "revise-proposal",
        "expected_revision": {
          "kind": "proposal-revision-handle",
          "id": "proposal-revision:sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "schema_version": 1
        },
        "change_set": {
          "purpose": {
            "summary": "Refine the written-plan exclusion",
            "rationale": "The bounded-local exclusion should remain explicit after the initial policy revision.",
            "evidence": [
              {
                "id": "evidence.planning-follow-up",
                "digest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
                "provider_contract": "review-evidence",
                "provider_contract_version": "1"
              }
            ]
          },
          "edits": [
            {
              "kind": "revise-policy-unit",
              "policy": "workflow.planning.written-plan-applicability",
              "title": "When A Written Plan Is Required",
              "body": "Apply the bounded-local exclusion first, then create a written plan only when material coordination or acceptance complexity must remain stable during implementation.",
              "semantics": {
                "kind": "change",
                "accepted_semantic_revision": 1,
                "proposed_semantic_revision": 2,
                "intent": "Preserve the bounded-local exclusion while tightening the planning trigger."
              }
            }
          ]
        }
      }
    },
